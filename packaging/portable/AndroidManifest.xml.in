<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@APP_ID@" android:versionCode="@BUILD@" android:versionName="@VERSION@">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:label="北化课伴" android:allowBackup="false" android:usesCleartextTraffic="false"
      android:icon="@mipmap/ic_launcher">
    <activity android:name="org.golang.app.GoNativeActivity" android:exported="true"
        android:configChanges="orientation|keyboardHidden|uiMode" android:theme="@android:style/Theme.Black.NoTitleBar">
      <meta-data android:name="android.app.lib_name" android:value="buct_companion" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <receiver android:name="org.golang.app.FyneNotificationReceiver" android:exported="false" />
  </application>
</manifest>
