<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Ink" Color="#172942" />
  <SolidColorBrush x:Key="Muted" Color="#485D75" />
  <SolidColorBrush x:Key="Line" Color="#AEBFD4" />
  <SolidColorBrush x:Key="Accent" Color="#1F58A0" />
  <SolidColorBrush x:Key="Canvas" Color="#EEF4FA" />
  <SolidColorBrush x:Key="GlassChip" Color="#B5E6F1FC" />
  <SolidColorBrush x:Key="GlassHover" Color="#DDF1F7FF" />
  <SolidColorBrush x:Key="GlassSelected" Color="#C0D8F4" />
  <SolidColorBrush x:Key="GlassSelectedEdge" Color="#91B7DF" />
  <SolidColorBrush x:Key="GlassInput" Color="#E6FFFFFF" />
  <SolidColorBrush x:Key="CourseFill" Color="#C9E1F2EB" />
  <SolidColorBrush x:Key="CourseBlue" Color="#D9DDEBFC" />
  <SolidColorBrush x:Key="CourseRose" Color="#D9F8E3EB" />
  <SolidColorBrush x:Key="CourseAmber" Color="#D9FAEDD3" />
  <SolidColorBrush x:Key="CourseViolet" Color="#DEEDE5FC" />
  <SolidColorBrush x:Key="ExamFill" Color="#E7FFF1DA" />
  <SolidColorBrush x:Key="ExamEdge" Color="#DEC396" />
  <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0.25,1">
    <GradientStop Color="#ECFFFFFF" Offset="0" />
    <GradientStop Color="#A5F6FAFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassRaised" StartPoint="0,0" EndPoint="0.85,1">
    <GradientStop Color="#F3FFFFFF" Offset="0" />
    <GradientStop Color="#B9EFF6FD" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#FFFFFFFF" Offset="0" />
    <GradientStop Color="#EBFFFFFF" Offset="0.45" />
    <GradientStop Color="#92A9BED9" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryGlass" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#326DB6" Offset="0" />
    <GradientStop Color="#204F90" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassBackdrop" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#EDF5FE" Offset="0" />
    <GradientStop Color="#E2ECF8" Offset="0.52" />
    <GradientStop Color="#EBE5F8" Offset="1" />
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="BackdropBlue" Center="0.54,0.42" GradientOrigin="0.52,0.45" RadiusX="0.50" RadiusY="0.52">
    <GradientStop Color="#BA92BDEB" Offset="0" />
    <GradientStop Color="#558CB8E9" Offset="0.56" />
    <GradientStop Color="#008CB8E9" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="BackdropMint" RadiusX="0.52" RadiusY="0.5">
    <GradientStop Color="#C1A1DDD4" Offset="0" />
    <GradientStop Color="#57A7DFD6" Offset="0.57" />
    <GradientStop Color="#00A7DFD6" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="BackdropLilac" RadiusX="0.54" RadiusY="0.54">
    <GradientStop Color="#B2BFB0E9" Offset="0" />
    <GradientStop Color="#4FBFB0E9" Offset="0.56" />
    <GradientStop Color="#00BFB0E9" Offset="1" />
  </RadialGradientBrush>
  <Style x:Key="FrostedPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="GlassListItem" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Margin" Value="0,0,2,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="ItemSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource GlassHover}" /></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource GlassSelected}" />
              <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource GlassSelectedEdge}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
